// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ATURAN INTEGRITAS (dijaga database lewat composite FK, tanpa trigger)
//
//  1. StarterList: peserta & stage harus satu event          (eventId)
//  2. StarterList: kelas peserta harus terdaftar di stage    (classId -> StageClass)
//  3. RaceRecord : peserta harus sudah ada di StarterList stage itu
//  4. RaceRecord : marshal harus satu event dengan stage
//
// Kolom salinan (eventId / classId) di tabel anak WAJIB diisi dari kode,
// diambil dari tabel induk (Participant / StarterList) atau dari JWT socket.
// Semua composite FK memakai onDelete & onUpdate: Restrict supaya perilakunya
// eksplisit: induk tidak bisa dihapus/diubah selama masih punya anak.
// =============================================================================

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  username  String   @unique
  password  String
  name      String
  position  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Event {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  date      DateTime
  location  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  marshals      Marshal[]
  specialStages SpecialStage[]
  participants  Participant[]

  @@map("events")
}

model Marshal {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  username  String   @unique
  password  String
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  raceRecords RaceRecord[]

  // Target composite FK dari RaceRecord (marshalId, eventId)
  @@unique([id, eventId])
  @@index([eventId])
  @@map("marshals")
}

model SpecialStage {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  status    String
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stageClasses StageClass[]
  starterLists StarterList[]

  // Target composite FK dari StarterList (stageId, eventId)
  @@unique([id, eventId])
  @@index([eventId])
  @@map("special_stages")
}

// Master kelas balapan (G1, G2, G3, G4, ...)
model RaceClass {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants Participant[]
  stageClasses StageClass[]

  @@map("classes")
}

model Participant {
  id              String   @id @default(uuid(7)) @db.Uuid
  driverName      String   @map("driver_name")
  driverRegion    String   @map("driver_region")
  navigatorName   String   @map("navigator_name")
  navigatorRegion String   @map("navigator_region")
  raceNumber      Int      @map("race_number")
  team            String
  classId         String   @map("class_id") @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  raceClass    RaceClass     @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  starterLists StarterList[]

  // Target composite FK dari StarterList (participantId, eventId, classId)
  @@unique([id, eventId, classId])
  // Opsional: nomor start unik per event (aktifkan jika data lama sudah bersih)
  // @@unique([eventId, raceNumber])
  @@index([eventId, classId])
  @@index([classId])
  @@map("participants")
}

// Kelas apa saja yang balapan di suatu special stage
model StageClass {
  id        String   @id @default(uuid(7)) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stage        SpecialStage  @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  raceClass    RaceClass     @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  starterLists StarterList[]

  // Target composite FK dari StarterList (stageId, classId)
  @@unique([stageId, classId])
  @@index([classId])
  @@map("stage_classes")
}

model StarterList {
  id            String   @id @default(uuid(7)) @db.Uuid
  timeControl   DateTime @map("time_control")
  participantId String   @map("participant_id") @db.Uuid
  stageId       String   @map("stage_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid // salinan dari Participant
  classId       String   @map("class_id") @db.Uuid // salinan dari Participant
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Aturan 1: peserta ada, dan eventId & classId-nya cocok dengan peserta
  participant Participant @relation(fields: [participantId, eventId, classId], references: [id, eventId, classId], map: "starter_lists_participant_fkey", onDelete: Restrict, onUpdate: Restrict)

  // Aturan 1: stage ada dan satu event dengan peserta
  stage SpecialStage @relation(fields: [stageId, eventId], references: [id, eventId], map: "starter_lists_stage_event_fkey", onDelete: Restrict, onUpdate: Restrict)

  // Aturan 2: kelas peserta terdaftar di stage ini
  stageClass StageClass @relation(fields: [stageId, classId], references: [stageId, classId], map: "starter_lists_stage_class_fkey", onDelete: Restrict, onUpdate: Restrict)

  raceRecords RaceRecord[]

  // Aturan bisnis: satu peserta hanya sekali per stage
  @@unique([participantId, stageId])
  // Target composite FK dari RaceRecord (participantId, stageId, eventId)
  @@unique([participantId, stageId, eventId])
  // Daftar start per stage, urut waktu
  @@index([stageId, timeControl])
  @@map("starter_lists")
}

model RaceRecord {
  id            String   @id @default(uuid(7)) @db.Uuid
  time          DateTime
  point         Int
  penaltyPoint  Int      @map("penalty_point")
  participantId String   @map("participant_id") @db.Uuid
  marshalId     String   @map("marshal_id") @db.Uuid
  stageId       String   @map("stage_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid // salinan dari StarterList / JWT marshal
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Aturan 3: peserta sudah masuk Starter List di stage & event ini.
  // Peserta dan stage dijangkau lewat starterList.participant / starterList.stage.
  starterList StarterList @relation(fields: [participantId, stageId, eventId], references: [participantId, stageId, eventId], map: "race_records_starter_fkey", onDelete: Restrict, onUpdate: Restrict)

  // Aturan 4: marshal berasal dari event yang sama
  marshal Marshal @relation(fields: [marshalId, eventId], references: [id, eventId], map: "race_records_marshal_event_fkey", onDelete: Restrict, onUpdate: Restrict)

  // Query livescore per stage (terbaru dulu / sejak timestamp tertentu)
  @@index([stageId, createdAt])
  // Sisi anak FK ke StarterList (hapus/ubah Starter List tanpa full scan)
  @@index([participantId, stageId, eventId])
  // Sisi anak FK ke Marshal
  @@index([marshalId, eventId])
  @@map("race_records")
}
